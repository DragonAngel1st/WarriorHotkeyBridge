{
  "Chrome": {
    "CdpEndpoint": "http://127.0.0.1:9222",
    "ExecutablePath": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "UserDataDirectory": "",
    "AutoLaunch": false,
    "StartUrl": "https://www.warriortrading.com/login-member/",
    "RelaunchCooldownSeconds": 30,
    "ConnectTimeoutMs": 5000,
    "ReconnectInitialDelayMs": 1000,
    "ReconnectMaxDelayMs": 30000,
    "HealthCheckIntervalMs": 3000
  },

  "WarriorSim": {
    "AllowedHost": "sim.warriortrading.com",
    "ExpectedTitle": "Sim Trading Platform",
    "Level2Selectors": [
      ".widget-t-level2",
      "div.flexlayout__tab_button"
    ],
    "Level2TabText": "Level 2 & Order Entry",
    "SelectedTabButtonClass": "flexlayout__tab_button--selected",
    "SelectedTabsetClass": "flexlayout__tabset-selected",
    "TabsetTabBarClass": "flexlayout__tabset_tabbar_outer",
    "TabButtonContentClass": "flexlayout__tab_button_content"
  },

  "Hotkeys": {
    "//": "Shipped defaults are the two safe, non-dispatching actions only, and they sit on spare keys. Trading bindings belong in the user file at %LOCALAPPDATA%\\WarriorHotkeyBridge\\Configuration\\appsettings.json. Configuration layers merge per key, not per object: if a binding were defined here AND overridden there, the merged entry could end up with both Send and Action set, which is rejected. Keeping these on keys the user file does not touch avoids that entirely.",
    "Bindings": {
      "F23": {
        "Action": "Test",
        "Label": "Targeting pipeline test - sends nothing"
      },
      "F24": {
        "Action": "Diagnostics",
        "Label": "Write diagnostic report to log"
      }
    }
  },

  "Commands": {
    "MaxCommandAgeMs": 5000
  },

  "Log": {
    "MinimumLevel": "Information",
    "RetainedFileCountLimit": 14,
    "FileSizeLimitBytes": 33554432
  }
}
