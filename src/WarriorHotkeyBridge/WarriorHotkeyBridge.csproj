<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      WinExe = no console window in normal operation. The subsystem is fixed at link
      time and .NET offers no supported way to change it at runtime, so debug mode
      attaches or allocates a console via Win32 instead (see Diagnostics/ConsoleHost.cs).
    -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WarriorHotkeyBridge</RootNamespace>
    <AssemblyName>WarriorHotkeyBridge</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Source-generated by ApplicationConfiguration.Initialize() in Program.Main. -->
  <PropertyGroup>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStylesEnabled>true</ApplicationVisualStylesEnabled>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- Shipped hotkey presets. Data, not code: adding one is a file, not a rebuild. These are
         replaced on upgrade, so the editor treats them as read-only; the operator's own presets
         live under %LOCALAPPDATA% and survive. -->
    <None Update="Presets\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Pure logic (URL validation, hotkey/command mapping, backoff, queue ordering) is
       unit tested without Chrome; the test project needs access to internal types. -->
  <ItemGroup>
    <InternalsVisibleTo Include="WarriorHotkeyBridge.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!--
    Artwork travels with the application rather than being embedded.

    The tray icons have to be files the running process can read from disk, because the icon is
    composed at the current DPI's small-icon size at runtime. The deck images are here for the
    operator: the whole point of shipping them is that they can be browsed to and picked in the
    Stream Deck software, which an embedded resource could never be.

    The MSI harvests the publish output wholesale, so landing them here is all that is needed to
    get them installed.
  -->
  <ItemGroup>
    <None Include="..\..\assets\icons\*.png"
          Link="assets\icons\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\streamdeck\*.png"
          Link="assets\streamdeck\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
