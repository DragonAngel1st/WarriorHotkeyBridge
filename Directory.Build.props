<Project>

  <!--
    Single authoritative version for the whole product.
    This flows into: assembly version, tray "About"/diagnostics output, log headers,
    and (Phase 10) the MSI ProductVersion and installer filename.
    Nothing else in the repository should hard-code a version number.
  -->
  <PropertyGroup>
    <VersionPrefix>1.1.1</VersionPrefix>
    <Product>Warrior Hotkey Bridge</Product>
    <Authors>Patrick Miron</Authors>
    <Copyright>Copyright Â© $([System.DateTime]::Now.Year) Patrick Miron</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required by the [LibraryImport] source generator used for Win32 interop. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Quality gates. Warnings are fixed, not suppressed. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    .NET 8+ artifacts layout: everything lands under ./artifacts instead of per-project
    bin/obj. This is what gives us the artifacts/publish + artifacts/installer shape
    the release process expects.
  -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

</Project>
